{
  "name": "jaltaranga-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-fixtures.mjs",
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/prepare-fixtures.mjs",
    "build": "tsc --noEmit && vite build && node scripts/check-size.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "pretest": "node scripts/prepare-fixtures.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "check:size": "node scripts/check-size.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.2",
    "@protomaps/basemaps": "5.7.2",
    "idb-keyval": "6.3.0",
    "maplibre-gl": "6.13.0",
    "pmtiles": "4.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/geojson": "7946.0.16",
    "@types/node": "24.7.2",
    "@vitejs/plugin-react": "6.1.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.2"
  }
}
