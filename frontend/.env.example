# Public static artefacts served by the data CloudFront distribution.
VITE_STATIC_BASE=
# API Gateway HTTP API base URL (no trailing slash).
VITE_API_BASE=
# Optional MapLibre style URL; the route SVG remains available without it.
VITE_BASEMAP_STYLE_URL=
# Optional CloudFront origin for the scenario's PMTiles.
VITE_TILES_BASE=
# Optional AWS Terrain Tiles (Terrarium PNGs); no runtime terrain is assumed offline.
VITE_TERRAIN_BASE=
VITE_SCENARIO_ID=yamuna-2023-07
VITE_HERO_COLONY=DEL-YP-04
